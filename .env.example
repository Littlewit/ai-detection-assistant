# ==================== AI检测助手配置 ====================

# 千问大模型 API (阿里云 DashScope)
# 获取方式: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-api-key-here
QWEN_TEXT_MODEL=qwen-max
QWEN_VL_MODEL=qwen-vl-max
QWEN_EMBEDDING_MODEL=text-embedding-v3

# 向量数据库
CHROMA_PERSIST_DIR=./data/chroma_db

# Redis (消息队列 + 缓存)
# 本地开发用 localhost，Docker 部署用 redis (服务名)
REDIS_URL=redis://localhost:6379/0

# 实验室资质配置 (用于报告审核)
LAB_CNAS_ID=L7462
LAB_CMA_ID=2016192581Z
LAB_CPSC_ID=1517

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8888
LOG_LEVEL=info
